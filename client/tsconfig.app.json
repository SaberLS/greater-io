{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ESNext",
    /* Bundler mode */
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": true,

    /* Linting */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["node"],
    "useDefineForClassFields": true
  },
  "include": ["src"]
}
