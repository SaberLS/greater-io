{
  "name": "@greater-io/shared",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./constants": {
      "types": "./dist/src/constants/index.d.ts",
      "import": "./dist/src/constants/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "node esbuild.config.js && tsc -p tsconfig.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "clean:all": "rimraf dist tsconfig.tsbuildinfo node_modules",
    "clean:restart": "pnpm clean:all && pnpm --filter shared install"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@greater-io/tools": "workspace:^",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "esbuild": "^0.25.5",
    "esbuild-node-externals": "^1.18.0",
    "eslint": "^9.25.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "^16.0.0",
    "jiti": "^2.4.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
